# Resend API key for contact form and order email delivery
# Get yours at https://resend.com
RESEND_API_KEY=

# Email address where inquiries and orders are sent
CONTACT_EMAIL=hello@lensandlight.com

# Razorpay payment integration (free signup for India)
# Get keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: Razorpay webhook secret for payment.captured events
# Webhook URL: https://yoursite.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Site URL (required in production and for Android app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Android app — URL the Capacitor WebView loads (your deployed site or local dev server)
# Emulator + local dev: CAPACITOR_SERVER_URL=http://10.0.2.2:3000
# Physical device + local dev: CAPACITOR_SERVER_URL=http://YOUR_PC_IP:3000
# Production: CAPACITOR_SERVER_URL=https://your-app.vercel.app
CAPACITOR_SERVER_URL=
