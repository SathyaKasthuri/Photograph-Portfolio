{
  "expo": {
    "name": "Lens & Light",
    "slug": "photographer-portfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icons/icon-512.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./public/icons/icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lensandlight.portfolio"
    },
    "android": {
      "package": "com.lensandlight.portfolio",
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/icon-512.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "web": {
      "favicon": "./public/icons/icon-192.png"
    }
  }
}
